.cabesalho_menu-hamburguer {
    width: 36px;
    height: 36px;
    background-image: url("../img/Menu.svg");
    background-repeat: no-repeat;
    background-position: center;
    display: inline-block;
}

.cabesalho {
    background-color:var(--branco) ;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: static;
}

.container {
    display: flex;
    align-items: center;
}

.container__imagem {
    padding: 1em;
}

.lista-Menu {
    display: none;
    position: absolute;
    top: 100%;
}

.container__botao:checked ~ .lista-Menu {
    display: block;
}
